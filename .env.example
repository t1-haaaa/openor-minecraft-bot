# Deployment environments: development | staging | production
# NEVER put production secrets in free-tier preview envs

# Vercel frontend (public only - never secrets)
NEXT_PUBLIC_OPENOR_API_URL=https://api.mcbots.example

# Openor API (server-side only)
OPENOR_API_URL=https://api.internal
EXECUTION_PROVIDER=self-hosted
# Supabase
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # server-side only, never NEXT_PUBLIC_
# Storage
SUPABASE_STORAGE_BUCKET=bot-artifacts
# Vault encryption (server-side only)
VAULT_ENCRYPTION_KEY=base64:...  # AES-256-GCM key, rotate via infra/secrets
# Monitoring
LOG_LEVEL=info

# --- UNSUITABLE providers (do not use for 24/7) ---
# Vercel, Cloudflare Workers, Supabase alone, Render Free, Koyeb Free are NOT execution hosts
